{
  "expo": {
    "name": "FaltaFilme",
    "slug": "faltaFilme",
    "scheme": "faltafilme",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/faltafilme-icon.png",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.faltafilme.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#07002F",
        "foregroundImage": "./assets/faltafilme-adaptive-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
